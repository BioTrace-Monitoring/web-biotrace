AMBIENTE_PROCESSO = desenvolvimento

# Configurações de conexão com o banco de dados
DB_HOST = 'localhost'
DB_DATABASE = 'biotrace'
DB_USER = 'webdataviz'
DB_PASSWORD = 'web123'
DB_PORT = '3306'

# Configurações do servidor de aplicação
APP_PORT = 3000
APP_HOST = localhost

# Configurações do JWT
JWT_SECRET = ''
JWT_EXPIRES_IN = 1h

ETHEREAL_USER=
ETHEREAL_PASS=

# Acesso à Gold. Na EC2, o SDK utiliza a IAM Role da instância.
S3_BUCKET=
AWS_REGION=us-east-1
S3_GOLD_PREFIX=gold/

# Opcional para teste local: pasta que contém a subpasta gold/.
GOLD_LOCAL_DIR=
