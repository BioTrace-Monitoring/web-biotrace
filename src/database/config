var mysql = require("mysql2");

var mySqlConfig = {
    host: process.env.DB_HOST,
    database: process.env.DB_DATABASE,
    user: process.env.DB_USER,
    password: process.env.DB_PASSWORD,
    port: process.env.DB_PORT,
    charset: "utf8mb4"
};

function conectar() {
    var ambiente = process.env.AMBIENTE_PROCESSO;

    if (ambiente !== "producao" && ambiente !== "desenvolvimento") {
        throw new Error("Ambiente do banco não configurado.");
    }

    return mysql.createConnection(mySqlConfig).promise();
}

async function executar(instrucao, parametros, conexaoTransacao) {
    // Na transação, todas as consultas usam a mesma conexão.
    var conexao = conexaoTransacao || conectar();

    try {
        var resultado = await conexao.query(instrucao, parametros);
        return resultado[0];
    } finally {
        if (!conexaoTransacao) {
            await conexao.end();
        }
    }
}

module.exports = {
    executar,
    conectar
};
